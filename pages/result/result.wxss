.hero { text-align: center; padding: 48rpx 0 24rpx; }
.hero-emoji { font-size: 100rpx; line-height: 1; }
.hero-title { font-size: 52rpx; font-weight: 900; margin-top: 12rpx; color: #ffd54f; }
.hero-sub { font-size: 26rpx; opacity: .7; margin-top: 6rpx; }

.big-score { text-align: center; padding: 40rpx 0; margin-bottom: 20rpx; background: rgba(255,255,255,.06); border-radius: 24rpx; }
.score-num { font-size: 120rpx; font-weight: 900; color: #ffd54f; line-height: 1; }
.score-label { font-size: 26rpx; opacity: .7; margin-top: 8rpx; }
.score-pct { display: inline-block; margin-top: 16rpx; font-size: 32rpx; font-weight: 700; padding: 6rpx 24rpx; border-radius: 999rpx; background: rgba(255,213,79,.15); color: #ffd54f; }

.q-item { padding: 18rpx 0; border-bottom: 1rpx dashed rgba(255,255,255,.12); }
.q-item:last-child { border-bottom: none; }
.q-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.q-label { font-size: 24rpx; opacity: .6; }
.q-score { font-size: 30rpx; font-weight: 700; }
.q-score.perfect { color: #95de64; }

.q-en { font-size: 30rpx; color: #fff; line-height: 1.6; padding: 14rpx; background: rgba(255,213,79,.08); border-radius: 10rpx; margin-bottom: 12rpx; }
.q-choice { font-size: 28rpx; padding: 8rpx 12rpx; border-radius: 8rpx; margin-bottom: 8rpx; }
.q-choice.good { background: rgba(82,196,26,.2); color: #95de64; }
.q-choice.bad  { background: rgba(255,77,79,.18); color: #ff7875; }
.q-answer { font-size: 26rpx; opacity: .85; padding: 8rpx 12rpx; background: rgba(0,0,0,.18); border-radius: 8rpx; }

.actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.actions .btn-secondary { flex: 1; }
.actions .act-btn { flex: 2; }
