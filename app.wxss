page {
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  background: linear-gradient(180deg, #2c5364 0%, #203a43 100%);
  min-height: 100vh;
  color: #fff;
}
.container {
  padding: 32rpx;
  box-sizing: border-box;
}
.card {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  backdrop-filter: blur(10px);
}
.btn-primary {
  display: block;
  width: 100%;
  background: linear-gradient(180deg, #ffd54f, #ffb300);
  color: #4e2c00;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  border-radius: 999rpx;
  padding: 24rpx 0;
  border: none;
  box-shadow: 0 8rpx 0 #c17900, 0 16rpx 40rpx rgba(0,0,0,.3);
}
.btn-primary::after { border: none; }
.btn-secondary {
  display: inline-block;
  background: rgba(255,255,255,.15);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255,255,255,.25);
}
.btn-secondary::after { border: none; }
